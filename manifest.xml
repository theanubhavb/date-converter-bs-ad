<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>7535f9a5-4e61-4b8c-a5ca-c9edfdc7b3f5</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Date Converter</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="BS/AD Date Converter"/>
  <Description DefaultValue="Bikram Sambat and Gregorian date conversion functions for Excel."/>
  <IconUrl DefaultValue="https://theanubhavb.github.io/date-converter-bs-ad/assets/icon-32.png"/>
  <SupportUrl DefaultValue="https://github.com/theanubhavb/date-converter-bs-ad/issues"/>
  <AppDomains><AppDomain>https://theanubhavb.github.io/date-converter-bs-ad</AppDomain></AppDomains>
  <Hosts><Host Name="Workbook"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="ExcelApi"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://theanubhavb.github.io/date-converter-bs-ad/taskpane.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="ExcelApi"/><bt:Set Name="CustomFunctionsRuntime" MinVersion="1.1"/></bt:Sets></Requirements>
      <Hosts><Host xsi:type="Workbook"><AllFormFactors>
        <ExtensionPoint xsi:type="CustomFunctions">
          <Script><SourceLocation resid="Functions.Script.Url"/></Script>
          <Page><SourceLocation resid="Functions.Page.Url"/></Page>
          <Metadata><SourceLocation resid="Functions.Metadata.Url"/></Metadata>
          <Namespace resid="Functions.Namespace"/>
        </ExtensionPoint>
      </AllFormFactors></Host></Hosts>
      <Resources>
        <bt:Urls><bt:Url id="Functions.Script.Url" DefaultValue="https://theanubhavb.github.io/date-converter-bs-ad/functions.js"/><bt:Url id="Functions.Page.Url" DefaultValue="https://theanubhavb.github.io/date-converter-bs-ad/functions.html"/><bt:Url id="Functions.Metadata.Url" DefaultValue="https://theanubhavb.github.io/date-converter-bs-ad/functions.json"/></bt:Urls>
        <bt:ShortStrings><bt:String id="Functions.Namespace" DefaultValue="NPDATE"/></bt:ShortStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
